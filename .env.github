# liquidation-terminal: self-hosted aggr infrastructure (home server behind a Cloudflare Tunnel)
#   history.liqterm-api.fyi  aggr-server + InfluxDB (historical bars, /products)
#   proxy.liqterm-api.fyi    allowlisted CORS proxy (exchange product lists, KuCoin token)
VITE_APP_PROXY_URL=https://proxy.liqterm-api.fyi/
VITE_APP_API_URL=https://history.liqterm-api.fyi/
# community indicator library (lib.aggr.trade) removed: empty disables the Community tab and publishing
VITE_APP_LIB_URL=
VITE_APP_LIB_REPO_URL=
VITE_APP_BASE_PATH=/aggr/
VITE_APP_API_SUPPORTED_TIMEFRAMES=5,10,15,30,60,180,300,900,1260,1800,3600,7200,14400,21600,28800,43200,86400
# no VAPID key = aggr server-side push alerts disabled
